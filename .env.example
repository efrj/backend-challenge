# Copied to .env for local Bun (`cp .env.example .env`).
# Bun loads .env automatically. If .env is absent and NODE_ENV is not production,
# the process fills any missing key from this file.
# Docker Compose loads this file into the app containers and overrides only the
# values that differ inside the compose network (DB_HOST, SQS_ENDPOINT, INSTANCE_ID).

# Server
NODE_ENV=development
PORT=3000
INSTANCE_ID=local-dev
# Authentication mode: 'noop' (trusted caller / local dev & automated tests) or 'casdoor' / 'strict' (OIDC/JWKS RS256 verification via Casdoor)
AUTH_MODE=noop

# Casdoor IAM / OIDC (Keycloak lightweight replacement in Go)
CASDOOR_PORT=8000
CASDOOR_ENDPOINT=http://localhost:8000
CASDOOR_JWKS_URL=http://localhost:8000/.well-known/jwks
CASDOOR_ISSUER=
CASDOOR_AUDIENCE=
CASDOOR_ADMIN_PASSWORD=123

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=jungle
DB_PASSWORD=jungle_secret
DB_NAME=wagering_db
DB_POOL_MAX=15

# AWS SQS (LocalStack)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wager-integration-events.fifo
SQS_MAX_RECEIVE_COUNT=3
SQS_VISIBILITY_TIMEOUT_SEC=30

# Workers and migrations
AUTO_MIGRATE=true
WORKERS_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=250
PENDING_REF_POLL_INTERVAL_MS=500
PENDING_REF_MAX_ATTEMPTS=5
PENDING_REF_INITIAL_BACKOFF_MS=200

# Integration tests use a separate database on the same PostgreSQL instance
TEST_DB_NAME=wagering_test_db

# OpenTelemetry. Disabled by default so tests and local Bun do not export.
# Docker Compose turns it on and points the endpoint at the collector.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=wagering-processor
OTEL_EXPORT_INTERVAL_MS=5000
