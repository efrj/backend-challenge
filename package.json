{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "description": "Jungle Gaming Technical Challenge — Distributed Wagering Processor",
  "private": true,
  "scripts": {
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch run src/main.ts",
    "build": "bun build src/main.ts --outdir ./dist --target bun",
    "migration:up": "bun run src/infrastructure/persistence/cli-migrate.ts up",
    "migration:down": "bun run src/infrastructure/persistence/cli-migrate.ts down",
    "test": "bun test test/unit test/integration test/concurrency",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:load": "bun run test/load/load-test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@mikro-orm/core": "^6.4.3",
    "@mikro-orm/migrations": "^6.4.3",
    "@mikro-orm/nestjs": "^6.1.0",
    "@mikro-orm/postgresql": "^6.4.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "decimal.js": "^10.4.3",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}

